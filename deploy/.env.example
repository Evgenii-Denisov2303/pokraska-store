PORT=4173
HOST=0.0.0.0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

TRUST_PROXY=true
FORCE_HTTPS=true
COOKIE_SECURE=auto

LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000
SESSION_TTL_MS=43200000

# Можно ограничить доступ к админке по IP:
# ADMIN_ALLOWED_IPS=1.2.3.4,5.6.7.8
ADMIN_ALLOWED_IPS=

# Если публичный сайт остается на другом домене и будет читать JSON отсюда:
# CONTENT_CORS_ORIGINS=https://pokraska.store,https://www.pokraska.store
CONTENT_CORS_ORIGINS=
