{
  "name": "pokraska-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/admin-server.js",
    "convert-webp": "node scripts/convert-to-webp.js",
    "sync-inner-shell": "node scripts/sync-inner-shell.js",
    "check:whitespace": "git diff --check",
    "check:site": "node scripts/check-site-integrity.js",
    "check:publish": "npm run check:whitespace && npm run check:site && npm run test:responsive",
    "test:responsive": "playwright test",
    "test:responsive:headed": "playwright test --headed",
    "test:responsive:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "sharp": "^0.33.0"
  }
}
